{
  "name": "oli",
  "productName": "Oli",
  "version": "1.1.0",
  "description": "Sovereign AI meeting copilot that lives in a notch-style overlay on Mac and Windows.",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check server/index.js",
    "test": "node --test",
    "build:native:mac": "swift build -c release --package-path native/macos",
    "dist:mac": "npm run build:native:mac && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "mcp": "node mcp/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.oli.copilot",
    "files": [
      "electron/**",
      "server/**",
      "renderer/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/macos/.build/release/OliNotchGeometry",
        "to": "native/OliNotchGeometry",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Oli uses your microphone to transcribe your side of the conversation.",
        "NSScreenCaptureUsageDescription": "Oli uses screen capture only to receive shared meeting-tab/system audio. Video frames are not stored."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  }
}
