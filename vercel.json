{
  "version": 2,
  "buildCommand": "mkdir -p .vercel-static",
  "outputDirectory": ".vercel-static",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/notch.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
